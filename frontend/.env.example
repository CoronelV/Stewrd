VITE_BACKEND_URL=http://localhost:8080

# ==========================================
# Source Database Session Configuration
# ==========================================
# Channel type: "Direct (Local)" | "SSH Tunnel" | "AWS SSM"
VITE_SOURCE_CHANNEL_TYPE="SSH Tunnel"
# Database engine: "mysql" | "percona"
VITE_SOURCE_ENGINE=mysql
# Environment badge: "DEV" | "STG" | "UAT" | "PRD"
VITE_SOURCE_ENVIRONMENT=DEV

# Source SSH Tunnel Settings (used when VITE_SOURCE_CHANNEL_TYPE="SSH Tunnel")
VITE_SOURCE_SSH_HOST=ssh.pythonanywhere.com
VITE_SOURCE_SSH_PORT=22
VITE_SOURCE_SSH_USER=
VITE_SOURCE_SSH_PASSWORD=
VITE_SOURCE_SSH_PRIVATE_KEY_PATH=
VITE_SOURCE_SSH_INSECURE_IGNORE_HOST_KEY=false

# Source AWS SSM Tunnel Settings (used when VITE_SOURCE_CHANNEL_TYPE="AWS SSM")
VITE_SOURCE_AWS_PROFILE=
VITE_SOURCE_AWS_BASTION_HOST=
VITE_SOURCE_AWS_REMOTE_DB_HOST=
VITE_SOURCE_AWS_REMOTE_DB_PORT=5432
VITE_SOURCE_AWS_LOCAL_PROXY_PORT=

# Source Database (MySQL) Endpoint Settings
VITE_SOURCE_DB_HOST=127.0.0.1
VITE_SOURCE_DB_PORT=3306
VITE_SOURCE_DB_USER=root
VITE_SOURCE_DB_PASSWORD=
VITE_SOURCE_DB_SCHEMA=

# ==========================================
# Target Database Session Configuration
# ==========================================
# Channel type: "Direct (Local)" | "SSH Tunnel"
VITE_TARGET_CHANNEL_TYPE="Direct (Local)"
# Database engine: "mysql" | "percona"
VITE_TARGET_ENGINE=mysql
# Environment badge: "DEV" | "STG" | "UAT" | "PRD"
VITE_TARGET_ENVIRONMENT=DEV

# Target SSH Tunnel Settings (used when VITE_TARGET_CHANNEL_TYPE="SSH Tunnel")
VITE_TARGET_SSH_HOST=
VITE_TARGET_SSH_PORT=22
VITE_TARGET_SSH_USER=
VITE_TARGET_SSH_PASSWORD=
VITE_TARGET_SSH_PRIVATE_KEY_PATH=
VITE_TARGET_SSH_INSECURE_IGNORE_HOST_KEY=false

# Target Database (MySQL) Endpoint Settings
VITE_TARGET_DB_HOST=127.0.0.1
VITE_TARGET_DB_PORT=3306
VITE_TARGET_DB_USER=root
VITE_TARGET_DB_PASSWORD=
VITE_TARGET_DB_SCHEMA=
